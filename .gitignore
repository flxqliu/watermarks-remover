# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.github/
!/.github/**
!/docs/
!/docs/**
!/service/
!/service/**
# git never descends into an excluded directory, so /skills/ itself must be
# re-included before per-skill rules can match anything beneath it.
!/skills/
/skills/*
!/skills/clean-user-facing-text/
!/skills/clean-user-facing-text/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/skills/remove-ai-marks-desktop/
!/skills/remove-ai-marks-desktop/**
!/package_desktop_skill.py
!/tests/
!/tests/**
!/.dockerignore
!/.env.example
!/.gitignore
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt
!/SECURITY.md

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak
